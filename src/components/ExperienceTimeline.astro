---
import { experienceEntries } from '../data/experience';
---

<section class="section" id="experience">
  <h2 class="index-header"><span class="num">002</span> - Experience</h2>
  <div class="timeline">
    {
      experienceEntries.map((entry) => (
        <div class="item">
          <div class="date">{entry.dateRange}</div>
          <div class="body">
            <h3>
              {entry.role}, {entry.org}
            </h3>
            <p>{entry.summary}</p>
            {entry.caseStudyHref && <a href={entry.caseStudyHref}>Read the case study -&gt;</a>}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .section {
    padding: 60px 48px;
    border-top: 1px solid var(--color-border);
  }

  .index-header {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 26px 0;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .index-header .num {
    color: var(--color-accent-2);
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  .item {
    display: flex;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .item:last-child {
    border-bottom: none;
  }

  .date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent-2);
    width: 140px;
    flex-shrink: 0;
    padding: 2px 20px 0 0;
    margin-right: 20px;
    border-right: 1px solid var(--color-border);
  }

  .body h3 {
    font-family: var(--font-mono);
    margin: 0 0 4px 0;
    font-size: 14.5px;
  }

  .body p {
    margin: 0 0 6px 0;
    color: var(--color-text-dim);
    font-size: 13px;
  }

  .body a {
    font-family: var(--font-mono);
    font-size: 12.5px;
    text-decoration: none;
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .section {
      padding: 44px 24px;
    }
  }

  @media (max-width: 480px) {
    .section {
      padding: 36px 16px;
    }

    .item {
      flex-direction: column;
      gap: 6px;
    }

    .date {
      width: auto;
      margin-right: 0;
      padding: 0 0 8px 0;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }
  }
</style>
